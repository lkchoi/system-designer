#!/usr/bin/env bash
# Enforce conventional commit messages.
# Format: type(scope)?: subject
# Types: feat, fix, chore, docs, refactor, test, perf, ci, build, style

set -euo pipefail

msg_file="$1"
msg=$(head -1 "$msg_file")

# Allow merge commits
if echo "$msg" | grep -qE '^Merge '; then
  exit 0
fi

pattern='^(feat|fix|chore|docs|refactor|test|perf|ci|build|style)(\(.+\))?!?: .+'

if ! echo "$msg" | grep -qE "$pattern"; then
  echo ""
  echo "ERROR: Commit message does not follow Conventional Commits."
  echo ""
  echo "  Expected: <type>(<scope>): <subject>"
  echo "  Types:    feat, fix, chore, docs, refactor, test, perf, ci, build, style"
  echo ""
  echo "  Got: $msg"
  echo ""
  exit 1
fi

# Subject should not end with a period
if echo "$msg" | grep -qE '\.$'; then
  echo "ERROR: Commit subject should not end with a period."
  exit 1
fi
